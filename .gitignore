# Chave de assinatura Android — NUNCA versionar
*.keystore
*.jks

# Teste de carga: JWTs gerados para os usuários sintéticos (só valem no Supabase local,
# mas são credenciais — não entram no repositório). Recriar com supabase/carga/gerar-tokens.mjs
supabase/carga/usuarios.json

# IDS E TOKENS gerados por supabase/e2e/montar-tres-clubes.mjs.
#
# O nome "atores" engana: alem dos ids, o arquivo guarda ACCESS TOKENS vivos das contas que o
# seeder criou. Ele entrou num commit por descuido na fase 9 e foi removido no mesmo minuto — a
# segunda vez no dia (a primeira foi a chave de assinatura do staging). As duas tem a mesma causa:
# um `git add -A` depois de um comando que gerou credencial. A regra que ficou: arquivo gerado por
# seeder entra no .gitignore ANTES de o seeder rodar pela primeira vez.
supabase/e2e/atores.json
supabase/e2e/atores.staging.json

# builds temporarios do gate de ambiente (supabase/tests/e2e/build-por-ambiente.mjs)
.tmp-build-ambiente/

# STAGING (fase 9): tudo que e CREDENCIAL do ambiente fica fora do git.
#
# `signing_keys.json` e uma CHAVE PRIVADA — quem a tiver assina token valido para o staging. Ela
# entrou num commit por descuido e foi removida no mesmo minuto; a linha abaixo existe para isso
# nao se repetir. O `.temp/start-secrets` do CLI guarda as variaveis dos containers, incluindo
# chaves de servico.
staging/.jwt-secret
staging/supabase/signing_keys.json
staging/supabase/.temp/
staging/supabase/.branches/
staging/supabase/migrations/
staging/supabase/functions/
staging/supabase/seed.sql
.env.staging
