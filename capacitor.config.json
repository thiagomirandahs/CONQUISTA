{
  "appId": "app.filhosdaconquista",
  "appName": "DesbravaClube",
  "webDir": "dist",
  "backgroundColor": "#07122fff",
  "android": {
    "backgroundColor": "#07122fff",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#07122f",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#1e3a8a",
      "overlaysWebView": false
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 10000,
      "resetWhenUpdate": true,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "updateUrl": "",
      "statsUrl": "",
      "channelUrl": ""
    },
    "SystemBars": {
      "insetsHandling": "css"
    }
  },
  "server": {
    "androidScheme": "https",
    "cleartext": false
  }
}
