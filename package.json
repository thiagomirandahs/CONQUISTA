{
  "name": "desbravaclube",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run test:ambiente",
    "build:cap": "cross-env CAP_BUILD=1 vite build",
    "cap:sync": "npm run build:cap && cap sync android",
    "test:db": "bash supabase/tests/run-tests.sh",
    "test:db:upgrade": "bash supabase/tests/run-tests.sh --upgrade",
    "db:reset": "npx --yes supabase@2.117.0 db reset --local",
    "test:db:real": "npm run db:reset && bash supabase/tests/run-tests.sh --db postgres --no-replay",
    "test:storage:e2e": "node supabase/tests/e2e/storage-imagens.mjs",
    "test:contexto:e2e": "node supabase/tests/e2e/contexto-do-clube.mjs",
    "test:edge:bundle": "bash supabase/tests/e2e/edge-bundle.sh",
    "curriculo:validar": "node supabase/curriculo-manifesto/validar.mjs",
    "curriculo:autoteste": "node supabase/curriculo-manifesto/validar.autoteste.mjs",
    "curriculo:importacao:gerar": "node supabase/curriculo-manifesto/gerar-importacao.mjs",
    "curriculo:importacao:check": "node supabase/curriculo-manifesto/gerar-importacao.mjs --check",
    "test:auth:e2e": "node supabase/tests/e2e/auth-confirmacao.mjs",
    "test:smoke": "node supabase/tests/smoke/smoke.mjs",
    "test:ambiente": "node supabase/tests/e2e/build-por-ambiente.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.108.2",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.42.0",
    "phaser": "^4.2.1",
    "qrcode-generator": "1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-legacy": "^8.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.1",
    "terser": "^5.16.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
